# Base URL backend REST API untuk Portfolio Mobile
# 1. Jika menguji di Android Emulator:
VITE_API_URL=http://10.0.2.2:3001

# 2. Jika menguji di HP fisik via Wi-Fi (gunakan IP laptop Anda):
# VITE_API_URL=http://192.168.1.10:3001

# 3. Jika backend sudah dideploy ke Cloud (Railway / Render / Supabase):
# VITE_API_URL=https://nama-backend-anda.up.railway.app
